{
  "datasets": [
    {
      "name": "1a47c470",
      "displayName": "incidents_bronze",
      "catalog": "il_sandbox",
      "config": {
        "version": "1.1",
        "source": "il_sandbox.detroit_911.incidents_bronze",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "displayName": "Call Date/Time",
            "format": {
              "type": "date_time",
              "dateFormat": "locale_short_month",
              "timeFormat": "locale_hour_minute"
            },
            "name": "call_datetime",
            "expr": "CAST(called_at / 1000 AS TIMESTAMP)",
            "comment": "Incident call timestamp converted from epoch milliseconds"
          },
          {
            "displayName": "Call Month",
            "format": {
              "type": "date",
              "dateFormat": "locale_short_month"
            },
            "name": "call_month",
            "expr": "DATE_TRUNC('MONTH', CAST(called_at / 1000 AS TIMESTAMP))",
            "comment": "Month of the incident call, truncated to first of month"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "displayName": "MTD Incidents",
            "window": [
              {
                "order": "call_month",
                "range": "current",
                "semiadditive": "last"
              }
            ],
            "name": "monthly_incidents",
            "expr": "COUNT(*) FILTER (WHERE DAY(call_datetime) <= DAY(CURRENT_DATE()))",
            "comment": "Month-to-date incident count, only days up to current day of month"
          },
          {
            "displayName": "Prior MTD Incidents",
            "window": [
              {
                "order": "call_month",
                "range": "current",
                "offset": "-1 month",
                "semiadditive": "last"
              }
            ],
            "name": "prior_month_incidents",
            "expr": "COUNT(*) FILTER (WHERE DAY(call_datetime) <= DAY(CURRENT_DATE()))",
            "comment": "Prior month-to-date incident count, same day-of-month cutoff for fair comparison"
          },
          {
            "displayName": "Avg Dispatch MTD",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "window": [
              {
                "order": "call_month",
                "range": "current",
                "semiadditive": "last"
              }
            ],
            "name": "avg_dispatch_mtd",
            "expr": "AVG(dispatch_time) FILTER (WHERE DAY(call_datetime) <= DAY(CURRENT_DATE()))",
            "comment": "Average dispatch time month-to-date, only days up to current day of month"
          },
          {
            "displayName": "Prior Avg Dispatch MTD",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "window": [
              {
                "order": "call_month",
                "range": "current",
                "offset": "-1 month",
                "semiadditive": "last"
              }
            ],
            "name": "prior_avg_dispatch_mtd",
            "expr": "AVG(dispatch_time) FILTER (WHERE DAY(call_datetime) <= DAY(CURRENT_DATE()))",
            "comment": "Prior month average dispatch time, same day-of-month cutoff"
          },
          {
            "displayName": "MoM Growth %",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            },
            "name": "mom_growth_pct",
            "expr": "(MEASURE(monthly_incidents) - MEASURE(prior_month_incidents)) / MEASURE(prior_month_incidents) * 100",
            "comment": "Month-over-month incident growth percentage"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "5b7775d9",
      "displayName": "Baseline",
      "layout": [
        {
          "widget": {
            "name": "incidents-mtd",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "1a47c470",
                  "fields": [
                    {
                      "name": "monthly(call_month)",
                      "expression": "DATE_TRUNC(\"MONTH\", `call_month`)"
                    },
                    {
                      "name": "measure(prior_month_incidents)",
                      "expression": "MEASURE(`prior_month_incidents`)"
                    },
                    {
                      "name": "measure(monthly_incidents)",
                      "expression": "MEASURE(`monthly_incidents`)"
                    }
                  ],
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "DESC",
                      "expression": "DATE_TRUNC(\"MONTH\", `call_month`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": {
                  "value": "Incidents MTD",
                  "fields": []
                }
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(monthly_incidents)"
                },
                "target": {
                  "fieldName": "measure(prior_month_incidents)",
                  "period": {
                    "type": "relative-to-value-period",
                    "offset": 0
                  }
                },
                "period": {
                  "fieldName": "monthly(call_month)"
                }
              },
              "data": {
